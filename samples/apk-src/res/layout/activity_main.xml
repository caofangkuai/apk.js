<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/logo"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FF202124"
            android:textSize="26sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hint"
            android:textColor="#FF5F6368"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/action"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="180dp"
            android:text="@string/action"
            android:textAllCaps="false"
            android:textColor="#FF1A73E8"
            android:backgroundTint="#FFE8F0FE" />

        <TextView
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/never"
            android:textColor="#FF188038"
            android:textSize="14sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/echo_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/echo_hint"
            android:textSize="15sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/echo_action"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/echo_action"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/echo_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/echo_empty"
            android:textColor="#FF202124"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/add_action"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/add_action"
            android:textAllCaps="false" />

        <LinearLayout
            android:id="@+id/dynamic_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/progress_action"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/progress_action"
            android:textAllCaps="false" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progress="0"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/progress_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/progress_label"
            android:textColor="#FF5F6368"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/pill_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pill_action"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:background="@drawable/pill_bg" />

        <TextView
            android:id="@+id/pill_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF188038"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_env"
            android:textColor="#FF202124"
            android:textSize="18sp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/build_action"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/build_action"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/build_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF5F6368"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/reflect_action"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/reflect_action"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/reflect_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF5F6368"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/activity_action"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/activity_action"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/activity_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF5F6368"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
