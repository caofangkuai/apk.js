{
  "name": "apk-web-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "浏览器内 APK/DEX 模拟器与 Canvas 版 Android Framework 子集",
  "scripts": {
    "build": "webpack",
    "build:dev": "cross-env NODE_ENV=development webpack",
    "test": "node tests/run.js",
    "check": "node tests/check.js",
    "test:all": "npm run check:coverage && npm run check:duplicates && npm run check:shadowing && npm run check:playground && npm run check:refs && npm run test && npm run check && npm run test:parse && npm run test:api && npm run test:hooks && npm run test:hooks-apk && npm run test:bundles && npm run test:layout-flag && npm run test:list-callbacks && npm run test:recyclerview && npm run test:appbar && npm run test:elevation-overlay && npm run test:dialog-theme && npm run test:progress-animation && npm run test:list-choices && npm run test:appcompat-hosts && npm run test:typed-array && npm run test:measure-constraints && npm run test:style-precedence && npm run test:inflate-dispatch && npm run test:system-service && npm run test:class-object && npm run test:zip && npm run test:listview && npm run test:format && npm run test:diagnose && npm run test:touch && npm run test:interaction && npm run test:widgets && npm run test:drawables",
    "test:parse": "node tests/parse-smoke.mjs",
    "render": "node tools/render-apk.mjs",
    "hook:apk": "node tools/hook-apk.mjs",
    "profile:apk": "node tools/profile-apk.mjs",
    "serve": "python3 -m http.server 8080 --directory site",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "site": "node tools/build-site.mjs",
    "serve:dev": "python3 -m http.server 8080",
    "test:drawables": "node tests/drawables.mjs",
    "setup:fonts": "bash tools/setup-fonts.sh",
    "check:refs": "node tools/check-refs.mjs",
    "diff:image": "node tools/image-diff.mjs",
    "render:batch": "node tools/render-batch.mjs",
    "docs:coverage": "node tools/framework-coverage.mjs",
    "check:coverage": "node tools/framework-coverage.mjs --check",
    "bench:render": "node tools/bench-render.mjs",
    "test:zip": "node tests/zip-limits.mjs",
    "test:listview": "node tests/listview-lazy.mjs",
    "check:duplicates": "node tools/check-duplicates.mjs",
    "check:shadowing": "node tools/check-shadowing.mjs",
    "check:playground": "node tools/check-playground.mjs",
    "test:api": "node tests/api.mjs",
    "test:hooks": "node tests/hooks.mjs",
    "test:bundles": "node tests/bundles.mjs",
    "test:layout-flag": "node tests/layout-flag.mjs",
    "test:list-callbacks": "node tests/list-callbacks.mjs",
    "test:recyclerview": "node tests/recyclerview.mjs",
    "test:appbar": "node tests/appbar-collapse.mjs",
    "test:elevation-overlay": "node tests/elevation-overlay.mjs",
    "test:dialog-theme": "node tests/dialog-theme.mjs",
    "test:progress-animation": "node tests/progress-animation.mjs",
    "test:list-choices": "node tests/list-choices.mjs",
    "test:appcompat-hosts": "node tests/appcompat-hosts.mjs",
    "test:typed-array": "node tests/typed-array-index.mjs",
    "test:measure-constraints": "node tests/measure-constraints.mjs",
    "test:style-precedence": "node tests/style-precedence.mjs",
    "test:inflate-dispatch": "node tests/inflate-dispatch.mjs",
    "test:system-service": "node tests/system-service-typing.mjs",
    "test:class-object": "node tests/class-object-typing.mjs",
    "test:hooks-apk": "node tests/hooks-apk.mjs",
    "test:widgets": "node tests/widgets.mjs",
    "render:widgets": "node tools/render-widgets.mjs",
    "test:interaction": "node tests/interaction.mjs",
    "diagnose": "node tools/diagnose-apk.mjs",
    "test:touch": "node tests/touch.mjs",
    "test:ui": "npm run setup:fonts && npm run test:touch && npm run test:interaction",
    "test:diagnose": "node tests/diagnose.mjs",
    "test:format": "node tests/format.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "canvas": "^3.2.3",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "terser-webpack-plugin": "^5.6.1",
    "vitepress": "^1.6.4",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3"
  }
}
