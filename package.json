{
  "name": "apk-web-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "浏览器内 APK/DEX 模拟器与 Canvas 版 Android Framework 子集",
  "scripts": {
    "build": "webpack",
    "build:dev": "cross-env NODE_ENV=development webpack",
    "test": "node tests/run.js",
    "check": "node tests/check.js",
    "test:all": "npm run check:refs && npm run test && npm run check && npm run test:parse && npm run test:drawables",
    "test:parse": "node tests/parse-smoke.mjs",
    "render": "node tools/render-apk.mjs",
    "serve": "python3 -m http.server 8080 --directory site",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "site": "node tools/build-site.mjs",
    "serve:dev": "python3 -m http.server 8080",
    "test:drawables": "node tests/drawables.mjs",
    "setup:fonts": "bash tools/setup-fonts.sh",
    "check:refs": "node tools/check-refs.mjs",
    "diff:image": "node tools/image-diff.mjs",
    "render:batch": "node tools/render-batch.mjs",
    "docs:coverage": "node tools/framework-coverage.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "canvas": "^3.2.3",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "terser-webpack-plugin": "^5.6.1",
    "vitepress": "^1.6.4",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3"
  }
}
